// ===== std.core — minimal core utilities (P0-05 / STD-01) =====
// Import with `import std.core;` and use as `std::min(...)` etc.
// The module's public interface is marked `export` (P0-04 / MOD-05).
module std.core;

export namespace std {

constexpr int32 min(int32 a, int32 b) {
    if (a < b) return a;
    return b;
}

constexpr int32 max(int32 a, int32 b) {
    if (a > b) return a;
    return b;
}

int32 clamp(int32 v, int32 lo, int32 hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

} // namespace std
