// ===== std.io — minimal I/O helpers (P0-05 / STD-12) =====
// Import with `import std.io;` and use as `std::print_int(...)` etc.
// The libc declarations are repeated here so the module is self-contained even
// when the compiler prelude is disabled (`--no-prelude`). They are module
// private; only the helpers are exported (P0-04 / MOD-05).
module std.io;

extern int32    printf(char* format, ...);
extern int32    putchar(int32 c);
extern int32    getchar();
extern int32    dprintf(int32 fd, char* format, ...);
extern int32    scanf(char* format, ...);

extern void*  fopen(char* path, char* mode);
extern int32    fclose(void* stream);
extern usize  fread(void* ptr, usize size, usize count, void* stream);
extern usize  fwrite(void* ptr, usize size, usize count, void* stream);
extern char*  fgets(char* str, int32 n, void* stream);
extern int32    fputs(char* s, void* stream);
extern int32    fgetc(void* stream);
extern int32    fputc(int32 c, void* stream);

export namespace std {

// ----- stdout -----

void print_int(int32 v) {
    printf("%d", v);
}

void print_char(char c) {
    putchar(c);
}

void print_str(char* s) {
    printf("%s", s);
}

void print_bool(int32 b) {
    if (b) {
        printf("true");
    } else {
        printf("false");
    }
}

// ----- stderr -----
// `dprintf(fd, ...)` writes to a raw file descriptor; fd 2 is stderr. This
// avoids exposing the C `FILE` type (STD-23).

void print_err_str(char* s) {
    dprintf(2, "%s", s);
}

void print_err_int(int32 v) {
    dprintf(2, "%d", v);
}

// ----- stdin -----

// Returns the next byte from stdin (0..255), or -1 at end of input.
int32 read_char() {
    return getchar();
}

// Reads a decimal integer from stdin. Returns the parsed value, or 0 when the
// input is not a valid integer (mirrors `atoi`; there is no separate error
// channel because SafeModern C has no exceptions).
int32 read_int() {
    int32 v = 0;
    scanf("%d", &v);
    return v;
}

// Reads one line from stdin into `buf` (capacity `cap`), excluding the
// newline. Returns the number of bytes stored. Always NUL-terminates.
int32 read_line(char* buf, int32 cap) {
    int32 i = 0;
    while (i < cap - 1) {
        int32 c = getchar();
        if (c == -1 || c == '\n') break;
        buf[i] = (char)c;
        i = i + 1;
    }
    buf[i] = 0;
    return i;
}

// ----- files -----
// A `FILE*` is passed around as an opaque `void*` handle.

void* file_open(char* path, char* mode) {
    return fopen(path, mode);
}

int32 file_close(void* f) {
    return fclose(f);
}

// Reads up to `n` bytes into `buf`; returns the number actually read.
usize file_read(void* f, void* buf, usize n) {
    return fread(buf, 1, n, f);
}

// Writes `n` bytes from `buf`; returns the number actually written.
usize file_write(void* f, void* buf, usize n) {
    return fwrite(buf, 1, n, f);
}

// Reads one line (including the newline, if any) into `buf`; returns `buf`
// on success, or null at end of file.
char* file_read_line(char* buf, int32 cap, void* f) {
    return fgets(buf, cap, f);
}

int32 file_read_char(void* f) {
    return fgetc(f);
}

int32 file_write_char(void* f, int32 c) {
    return fputc(c, f);
}

int32 file_write_str(void* f, char* s) {
    return fputs(s, f);
}

} // namespace std
